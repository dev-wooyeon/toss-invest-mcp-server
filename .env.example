# Required. Issued from Toss Securities WTS > Settings > Open API.
# Copy this file to .env.local and put real values there. .env.local is gitignored.
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=

# Optional. Used by account, asset, order, and order-info API tools when
# accountSeq is not passed as a tool argument.
TOSSINVEST_ACCOUNT=

# Optional. Defaults to the official production server in spec/openapi.json.
# Any override must be an HTTP(S) loopback URL for offline/local tests; arbitrary
# hosts are rejected so OAuth ClientId and Secret cannot be sent elsewhere.
TOSSINVEST_BASE_URL=https://openapi.tossinvest.com

# Optional. READ_ONLY is the default. DRY_RUN enables order-preparation workflows
# only. LIVE_TRADING is required before create/modify/cancel tools can call Toss.
TOSSINVEST_TRADING_MODE=READ_ONLY

# Backward-compatible legacy switch used only when TOSSINVEST_TRADING_MODE is unset.
TOSSINVEST_ENABLE_TRADING=false

# Optional retry settings for read requests and OAuth. Trading mutations never
# retry ambiguous 429/5xx responses, even when clientOrderId is present.
TOSSINVEST_MAX_RETRIES=2
TOSSINVEST_RETRY_BASE_DELAY_MS=500
TOSSINVEST_RETRY_MAX_DELAY_MS=5000
# Per-attempt upstream HTTP deadline. 1,000-120,000 ms; default 15,000 ms.
TOSSINVEST_REQUEST_TIMEOUT_MS=15000

# Required safety controls before LIVE_TRADING can create or modify orders.
# Keep READ_ONLY when these values are intentionally left blank.
TOSSINVEST_ALLOWED_SYMBOLS=
TOSSINVEST_BLOCKED_SYMBOLS=
TOSSINVEST_MAX_ORDER_AMOUNT_KRW=
TOSSINVEST_MAX_ORDER_AMOUNT_USD=
TOSSINVEST_REQUIRE_CLIENT_ORDER_ID=true
TOSSINVEST_ALLOW_MARKET_ORDER_WITHOUT_PRICE=false

# Optional local JSONL audit log. Does not log ClientId, Secret, or tokens.
TOSSINVEST_AUDIT_LOG=true
TOSSINVEST_AUDIT_LOG_PATH=audit/toss-invest-mcp-audit.jsonl

# Optional transport. --http stays on loopback by default and requires a
# separate bearer token of at least 32 random characters even in READ_ONLY mode.
# Keep the token only in a local env file. Set an exact origin only for browser
# clients; "*" is rejected. Non-loopback bind additionally requires the explicit
# MCP_HTTP_ALLOW_INSECURE_EXTERNAL_BIND=true risk opt-in and external TLS controls.
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_HTTP_PATH=/mcp
MCP_HTTP_BEARER_TOKEN=
MCP_HTTP_ALLOW_INSECURE_EXTERNAL_BIND=false
MCP_ALLOWED_ORIGIN=
MCP_HTTP_MAX_BODY_BYTES=1048576
# Slow-client/request limits for the built-in HTTP server.
MCP_HTTP_HEADERS_TIMEOUT_MS=10000
MCP_HTTP_REQUEST_TIMEOUT_MS=30000
MCP_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
MCP_HTTP_MAX_CONCURRENT_REQUESTS=32
